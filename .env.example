# Copiar a .env y ajustar valores para desarrollo local.
# NUNCA commitear .env con credenciales reales.

# --- MariaDB ---
MARIADB_DATABASE=avanza
MARIADB_USER=avanza_app
MARIADB_PASSWORD=avanza_dev_password_change_me
MARIADB_ROOT_PASSWORD=avanza_root_dev_password_change_me
# Puerto expuesto al host (mapeado distinto de 3306 por si hay otra instancia local)
MARIADB_HOST_PORT=3307

# --- Redis ---
# Sin exponer al host por defecto (solo red interna de docker-compose).
# Si necesitás acceso desde el host, descomentar el mapeo de puertos en
# docker-compose.yml y ajustar este valor si 6379 ya está en uso por otro proyecto.
REDIS_HOST_PORT=6380

# --- Prisma / app ---
# Debe coincidir con las credenciales de MariaDB de arriba.
DATABASE_URL="mysql://avanza_app:avanza_dev_password_change_me@localhost:3307/avanza"
REDIS_URL="redis://localhost:6380"

# Dentro de la red de docker-compose (contenedor `avanza` -> `mariadb`/`redis`),
# usar los nombres de servicio en vez de localhost:
# DATABASE_URL="mysql://avanza_app:avanza_dev_password_change_me@mariadb:3306/avanza"
# REDIS_URL="redis://redis:6379"
