# Copiar a .env y completar con valores reales (nunca commitear .env)

# --- MariaDB (usado por docker-compose y por DATABASE_URL) ---
MARIADB_ROOT_PASSWORD=changeme-root-password
MARIADB_DATABASE=avanza
MARIADB_USER=avanza
MARIADB_PASSWORD=changeme-app-password

# Prisma se conecta con el usuario de aplicación (no root)
DATABASE_URL="mysql://avanza:changeme-app-password@localhost:3306/avanza"

# Shadow DB para `prisma migrate dev` (detección de drift en desarrollo).
# La base "avanza_shadow" se crea sola vía docker/mariadb-init/01-shadow-db.sh
# — el usuario de app solo tiene permisos ahí, no en la BD real.
SHADOW_DATABASE_URL="mysql://avanza:changeme-app-password@localhost:3306/avanza_shadow"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- Sesiones ---
# No hace falta ningún secreto: la cookie de sesión guarda solo un id opaco
# (UUID v4) y todo el contenido vive en Redis, así que no hay nada que firmar.
# La revocación es real (se borra la clave en Redis), no depende de una firma.
