# ========================================================
# Variables de Entorno de Producción - AvanzA Platform
# Instrucciones:
# 1. Copiar este archivo como .env.production en el servidor:
#    cp .env.production.example .env.production
# 2. Generar contraseñas seguras (ej: openssl rand -hex 24)
# 3. NUNCA subir este archivo con valores reales al repositorio Git.
# ========================================================

# --- Puerto Público del Servidor ---
APP_PORT=3000

# --- Dominios Permitidos (CORS y Cabeceras de Seguridad) ---
# Si usas varios dominios, sepáralos por comas sin espacios:
ALLOWED_ORIGINS=https://avanza.tudominio.com

# --- Base de Datos MariaDB ---
DB_NAME=avanza_prod
DB_USER=avanza_app
DB_PASSWORD=CAMBIAR_POR_PASSWORD_MUY_SEGURO_DE_APP
DB_ROOT_PASSWORD=CAMBIAR_POR_PASSWORD_MUY_SEGURO_DE_ROOT

# --- Motor de Caché Redis ---
REDIS_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO_REDIS

# --- Proveedor de Correo Transaccional (Resend o SMTP) ---
# Obtén tu API Key en https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="AvanzA Coaching <notificaciones@tudominio.com>"

# --- Proveedores de Inteligencia Artificial (Copiloto de Coaching) ---
# Configura al menos una clave API para el copiloto reflexivo de los coachees:
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Pasarelas de Pago y Webhooks ---
# Clave compartida para autenticar webhooks de notificaciones de pago
PAYMENTS_WEBHOOK_SECRET=CAMBIAR_POR_SECRET_ALEATORIO
